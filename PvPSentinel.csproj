<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.3.1.19</Version>
    <Author>MarshalTitan</Author>
    <Name>PvP Sentinel</Name>
    <Punchline>Frontline strategy, safe navigation, lifecycle, and modular combat providers.</Punchline>
    <Description>Five-map Frontline objective navigation with dynamic allied-field-group following and bounded route recovery.</Description>
    <RepoUrl>https://github.com/MarshalTitan/PvPSentinel</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/MarshalTitan/PvPSentinel/main/assets/icon_clean.png</IconUrl>
    <Tags>pvp;frontline;machinist;navigation;beta</Tags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
  </ItemGroup>
</Project>
